# Copy to apps/web/.env.local (git-ignored) for local work. NEVER commit real values.
# (Next.js loads .env files from the app folder, not from the monorepo root.)
# Every environment (development / staging / production) has its OWN values.

APP_ENV=development
NEXT_PUBLIC_APP_ENV=development

# Local development uses an embedded database when this is unset.
# Staging and production REQUIRE a hosted Postgres URL provided by the hosting platform.
# DATABASE_URL=

# Our own canonical origin. Defaults to http://localhost:3000 in development; REQUIRED outside development
# (anchors the SIWE domain/uri hardening check in packages/auth/src/wallet-auth.ts).
# APP_ORIGIN=https://rush7-staging.example.com

# --- World integration (Phase 2). Nothing here works until the owner creates the Developer Portal apps
# (decision D1) and pastes the real values into apps/web/.env.local — NEVER into this file or into chat. ---

# The Mini App's own app_id from the Developer Portal. Public: MiniKitProvider ships it to the browser.
# NEXT_PUBLIC_WORLD_MINIAPP_ID=

# The World ID app's app_id, used by the IDKit widget. May be the same Portal app as above, or a separate
# one (docs/phase-0/01-world-docs-review.md §5.1, not yet confirmed which). Public.
# NEXT_PUBLIC_WORLD_ID_APP_ID=

# The World ID app's rp_id (server-only; used to build the verify-endpoint URL and the signed RP context).
# WORLD_ID_RP_ID=

# The World ID app's SECRET RP signing key. Never sent to the client, never logged, never committed.
# WORLD_ID_RP_SIGNING_KEY=

# Feature flags: all OFF by default. Do not enable without explicit approval.
RANKED_ENABLED=false
REWARDS_ENABLED=false
NOTIFICATIONS_ENABLED=false
